# Copy this file to .env and fill in your own values:
#     copy .env.example .env        (Windows PowerShell)
# .env is git-ignored. Never commit real keys or passwords.

# --- Django ---
# Any long random text (no $ sign). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16 + pgvector in Docker) ---
# docker-compose.yml creates the database with these values and Django connects
# with the same values. Pick your own local password; it never leaves your PC.
DB_NAME=circular_campus
DB_USER=circular
DB_PASSWORD=change-me-local-db-password
DB_HOST=localhost
DB_PORT=5432

# --- Test data (python manage.py seed_data) ---
# Password given to the 4 synthetic test users. Optional; default Synthetic-Demo-2026.
SEED_USER_PASSWORD=

# --- AI gateway ---
# minilm = local category suggestions and matching (AI #1, #2); off = fallback screens only
AI_EMBEDDINGS=minilm
# Text-generation provider for AI #5 (report summaries): gemini or off.
# off = the report pages show "Draft summary unavailable" and everything else works.
AI_TEXT_PROVIDER=off
# --- Google Gemini (free tier) for AI #5 ---
# Create a key at https://aistudio.google.com/apikey and paste it here (never commit it).
GEMINI_API_KEY=
# Model name as listed in Google AI Studio; empty = gemini-flash-lite-latest (fast, free tier)
GEMINI_MODEL=gemini-flash-lite-latest
